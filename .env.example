# Canonical credential for new DataChef Gemini integrations.
GOOGLE_API_KEY=

# Leave empty until the Phase 0C compatibility check verifies a model.
GEMINI_MODEL=

# Safe defaults: no provider calls, no row samples, no generated-code execution.
DATACHEF_OFFLINE=true
DATACHEF_SEND_ROW_SAMPLES=false
DATACHEF_ENABLE_EXPERIMENTAL_CODE_EXECUTION=false

# Keep local/offline development from exporting CrewAI telemetry.
CREWAI_DISABLE_TELEMETRY=true
CREWAI_DISABLE_TRACKING=true
OTEL_SDK_DISABLED=true
