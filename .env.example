# Copy this file to .env and fill in your own values.
# .env is gitignored: each developer keeps their own settings, so nobody has to
# edit source code (and conflict over it) just to use a different model.

# ---------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------
# Canonical name. GEMINI_API_KEY is still accepted as a legacy alias.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------
# Models  (all optional)
# ---------------------------------------------------------------------
# Leave everything commented out to use the built-in defaults.
#
# Resolution order, most specific first:
#   1. the per-role variable below
#   2. DATACHEF_MODEL
#   3. the built-in default in utils/config.py

# One knob for every Gemini call in the project:
# DATACHEF_MODEL=gemini-3.6-flash

# Per-role overrides. Roles are what the call is FOR, not which agent makes it:
#
#   transform -> Stage 3, generating and self-healing the pandas script.
#                This is the critical path: Stage 4 only unlocks once it
#                succeeds. Default: gemini-flash-lite-latest
#   insights  -> dashboard insights and the ingestion chat. Optional, both fall
#                back to rules. Default: gemini-3.1-flash-lite
#   chat      -> the dashboard "Ask for a chart" fallback, used only when the
#                deterministic rules cannot resolve the request.
#                Default: gemini-3.1-flash-lite
#
# DATACHEF_MODEL_TRANSFORM=gemini-flash-lite-latest
# DATACHEF_MODEL_INSIGHTS=gemini-3.1-flash-lite
# DATACHEF_MODEL_CHAT=gemini-3.1-flash-lite

# Why the defaults differ per role: on the free tier the request quota is PER
# MODEL PER DAY. Dashboard insights fire on every render, so if they shared a
# model with the transformation they would quietly consume the quota it needs.
# Different model = different quota pool. Set DATACHEF_MODEL alone if you would
# rather have everything on one model.
#
# Note that newer models carry TIGHTER free-tier limits: gemini-3.7-flash allows
# only 20 requests/day, and one transformation can spend several (each
# self-healing retry is another call). The "lite" family has more headroom.
#
# Prefer an ALIAS (gemini-flash-latest, gemini-flash-lite-latest) over a pinned
# version: Google retires old versions, and gemini-2.5-flash /
# gemini-2.5-flash-lite already return 404.
